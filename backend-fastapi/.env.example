# ---------------------------------------------------------------
# Copia este archivo como .env y rellena los valores reales.
# El .env NUNCA se sube al repositorio (esta en .gitignore).
# ---------------------------------------------------------------

ENTORNO=desarrollo
DEPURACION=true

# Origenes del frontend autorizados a llamar a esta API (sin comodines)
ORIGENES_PERMITIDOS=["http://localhost:5173","http://localhost:5174"]

# MySQL / MariaDB. Si la contrasena tiene simbolos, va codificada en la URL.
URL_BASE_DATOS=mysql+aiomysql://root:TU_CONTRASENA@localhost:3306/bixe_db

# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=reemplazar-por-una-clave-generada
ALGORITMO_JWT=HS256
MINUTOS_EXPIRACION_TOKEN=480

# Imagenes del catalogo
CARPETA_UPLOADS=uploads

# Recuperacion de contrasena
URL_FRONTEND=http://localhost:5173
MINUTOS_EXPIRACION_RECUPERACION=30

# --- Correo saliente -------------------------------------------
# Si SMTP_HOST queda vacio, la API no envia nada: escribe el enlace de
# recuperacion en el log del servidor para que puedas probarlo igual.
#
# Para Gmail hay que crear una "contrasena de aplicacion" en la cuenta de
# Google (Seguridad -> Verificacion en dos pasos -> Contrasenas de aplicacion).
# La contrasena normal de la cuenta NO funciona. Son 16 letras y se pegan
# seguidas, sin los espacios con los que Google las muestra.
#
# Cuando termines de rellenarlo, compruebalo con:
#   .venv/Scripts/python.exe scripts/probar_correo.py tucorreo@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_TLS=true

# Deja SMTP_REMITENTE vacio salvo que tengas dominio propio: el correo saldra
# desde la misma cuenta de SMTP_USUARIO, que es lo que Gmail exige. Si pones
# una direccion distinta, Gmail rechaza el envio o la reescribe.
SMTP_REMITENTE=

# --- Chatbot con Inteligencia Artificial ------------------------
# Si PROVEEDOR_IA o IA_API_KEY quedan vacios, el asistente sigue
# funcionando con respuestas preparadas a partir del catalogo real.
#
# PROVEEDOR_IA admite "anthropic" u "openai".
# La clave NUNCA se escribe en el codigo ni se sube al repositorio.
PROVEEDOR_IA=
IA_API_KEY=
IA_MODELO=
